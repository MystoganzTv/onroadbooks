# Dependencies
node_modules

# Next.js
.next
out
build
next-env.d.ts
tsconfig.tsbuildinfo

# Browser test artifacts and isolated ledger
.e2e-data
playwright-report
test-results
blob-report

# Secrets and environment
.env
.env*.local
*.pem

# Local ledger, uploaded receipts and the generated session key.
# The demo dataset rebuilds itself on first run, so nothing here belongs in
# version control -- and uploads/ holds real documents.
/data/*.json
/data/*.json.corrupt-*
/data/uploads/
/data/.auth-secret

# Generated Prisma client (rebuilt by `npm install` via postinstall)
/src/generated

# Local archives: build tarballs and design exports (the landing page zip).
# A stray tarball once got swept into a commit by `git add -A`.
*.tgz
*.tar.gz
*.zip

# Logs and OS noise
npm-debug.log*
yarn-error.log*
install.log
server.log
.DS_Store
Thumbs.db
.vercel
