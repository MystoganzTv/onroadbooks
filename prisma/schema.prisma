// OnRoad Books -- data model
//
// Designed for a single box truck today, but every financial row already
// hangs off a Truck and a Business, so adding trucks (or a second business)
// is additive rather than a migration of every table.
//
// Money is stored as Decimal(12,2) so Postgres, not floating point, owns
// rounding once a real database is connected.

generator client {
  provider      = "prisma-client-js"
  // Custom output keeps the generated client inside the repo (the
  // direction Prisma is moving in) and out of node_modules.
  output        = "../src/generated/prisma"
  // Vercel functions run on Linux with OpenSSL 3. Generate that engine even
  // when prisma generate is executed locally on an Apple Silicon Mac.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentStatus {
  PENDING
  INVOICED
  PAID
}

enum EquipmentType {
  BOX_TRUCK
  DRY_VAN
  REEFER
  FLATBED
  POWER_ONLY
  SPRINTER_VAN
  OTHER
}

enum LoadCapacity {
  FULL
  PARTIAL
}

enum ExpenseBehavior {
  FIXED
  VARIABLE
}

/// What an expense belongs to. TRUCK is a cost a unit caused; BUSINESS is
/// overhead the fleet carries between its units. Keeping them apart is what
/// lets a unit report an honest contribution instead of an invented profit.
enum ExpenseScope {
  TRUCK
  BUSINESS
}

enum FinancialTreatment {
  OPERATING
  INTEREST
  PRINCIPAL
  DEBT_UNALLOCATED
}

enum FinancialObligationKind {
  LOAN
  OPERATING_LEASE
  UNKNOWN
}

enum DocumentType {
  RATE_CONFIRMATION
  BOL
  POD
  INVOICE
  RECEIPT
  REGISTRATION
  INSURANCE
  TITLE
  INSPECTION
  OTHER
}

enum MaintenanceType {
  OIL_CHANGE
  OIL_FILTER
  FUEL_FILTER
  TIRES
  BRAKES
  TRANSMISSION
  COOLANT
  BATTERY
  DOT_INSPECTION
  STATE_INSPECTION
  REGISTRATION
  INSURANCE
  OTHER
}

/// What the next service is measured against.
enum MaintenanceBasis {
  DATE
  MILEAGE
  BOTH
}

enum ReserveKind {
  TAX
  MAINTENANCE
  EMERGENCY
  CUSTOM
}

/// What a reserve percentage is charged against.
enum ReserveBasis {
  OPERATING_PROFIT
  GROSS_REVENUE
}

enum ReserveTransactionType {
  CONTRIBUTION
  WITHDRAWAL
  ADJUSTMENT
}

enum SettlementHalf {
  FIRST
  SECOND
}

enum SettlementStatus {
  OPEN
  CLOSED
}

/// How a driver's pay is calculated for each load. The rate is stored on the
/// driver and copied into every settlement line so changing a contract never
/// rewrites a statement that was already prepared or paid.
enum DriverPayType {
  PERCENT_GROSS
  PER_LOADED_MILE
  PER_TOTAL_MILE
  FLAT_PER_LOAD
}

enum DriverSettlementStatus {
  DRAFT
  PAID
}

enum DriverSettlementAdjustmentType {
  ACCESSORIAL_PAY
  REIMBURSEMENT
  DEDUCTION
  ADVANCE
  OTHER_EARNING
}

enum PlanId {
  /// Kept for rows created before the three-tier catalogue. The application
  /// reads it as OWNER; removing it would make Prisma unable to decode those
  /// existing subscriptions before they can be migrated.
  INDIVIDUAL
  SOLO
  OWNER
  FLEET
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ExpenseCategory {
  FUEL
  TOLLS
  INSURANCE
  /// Legacy or intentionally unsplit debt payment. Never auto-reclassified.
  TRUCK_PAYMENT
  INTEREST_EXPENSE
  PRINCIPAL_PAYMENT
  OPERATING_LEASE
  MAINTENANCE
  REPAIRS
  PARKING
  DISPATCH
  FACTORING
  ELD
  PERMITS
  REGISTRATION
  OFFICE
  PHONE
  ACCOUNTING
  DRIVER_PAY
  OTHER
}

enum MemberRole {
  OWNER
  ADMIN
  BOOKKEEPER
  DISPATCHER
  VIEWER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  /// scrypt$<salt>$<hash>. Never selected into anything the client sees.
  passwordHash String
  role         MemberRole @default(OWNER)
  /// Set while an owner-created invitation is waiting to be accepted.
  invitedAt    DateTime?
  /// Null until the invited person completes a verified Supabase sign-in.
  joinedAt     DateTime?  @default(now())
  businessId   String?
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([businessId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  trucks               Truck[]
  loads                Load[]
  expenses             Expense[]
  financialObligations FinancialObligation[]
  paymentEvents        PaymentEvent[]
  fuelEntries          FuelEntry[]
  documents            Document[]
  maintenance          MaintenanceRecord[]
  settings             FinancialSettings?
  goals                FinancialGoal?
  subscription         Subscription?
  reserveAccounts      ReserveAccount[]
  reserveTransactions  ReserveTransaction[]
  settlements          Settlement[]
  drivers              Driver[]
  driverSettlements    DriverSettlement[]
}

/// What the owner is aiming at. One row per business; targets are monthly and
/// every shorter window is derived, never stored.
model FinancialGoal {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  monthlyRevenueTarget Decimal @default(0) @db.Decimal(12, 2)
  monthlyProfitTarget  Decimal @default(0) @db.Decimal(12, 2)
  targetProfitPerMile  Decimal @default(1.5) @db.Decimal(8, 2)
  maxDeadheadPct       Decimal @default(15) @db.Decimal(5, 2)
  targetLoads          Int?
  /// Days a week the truck is expected to run. Drives the daily target and
  /// the month-end projection.
  workingDaysPerWeek   Int     @default(6)
  expectedMonthlyMiles Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which plan a business is on, and whether it is paid up.
///
/// Prices and truck limits are NOT stored: they live in lib/plans.ts, because
/// a price is a product decision that ships with a release rather than a row
/// someone can edit into an inconsistent state. The provider columns are
/// null for an explicit complimentary admin grant. Stripe fills both provider
/// columns; the application never invents a provider subscription id.
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  plan   PlanId             @default(OWNER)
  status SubscriptionStatus @default(TRIALING)

  /// End of the trial or the paid period.
  currentPeriodEnd DateTime?

  providerCustomerId     String?
  providerSubscriptionId String? @unique

  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A virtual planning bucket. Not a bank account -- no real money moves.
model ReserveAccount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  kind  ReserveKind
  name  String
  basis ReserveBasis @default(GROSS_REVENUE)

  /// Null for the built-in TAX and MAINTENANCE buckets: their rates live in
  /// FinancialSettings so a reserve percentage is stored in one place only.
  contributionPct Decimal? @db.Decimal(5, 2)
  targetBalance   Decimal? @db.Decimal(12, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ReserveTransaction[]

  @@index([businessId])
}

/// A movement in a bucket. `amount` is signed: contributions positive,
/// withdrawals negative. A balance is always the running sum, never a column.
model ReserveTransaction {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId  String
  account    ReserveAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date        DateTime               @db.Date
  type        ReserveTransactionType
  amount      Decimal                @db.Decimal(12, 2)
  description String

  /// Set when the row was posted automatically by closing a settlement, so
  /// reopening that settlement can reverse exactly these rows.
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId, date])
  @@index([accountId])
  @@index([settlementId])
}

/// A half-month review, and the only place the app stores calculated values.
///
/// While OPEN the figures are recomputed live. CLOSING freezes `snapshot`, so
/// a later change to a reserve percentage or a backdated expense can never
/// rewrite a settlement the owner has already paid themselves on.
model Settlement {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Anchor month, "2026-08".
  month String         @db.VarChar(7)
  half  SettlementHalf

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status   SettlementStatus @default(OPEN)
  closedAt DateTime?
  /// Frozen SettlementSnapshot. Null while the settlement is open.
  snapshot Json?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reserveTransactions ReserveTransaction[]

  @@unique([businessId, month, half])
  @@index([businessId, periodStart])
}

model FinancialSettings {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Percent of operating profit set aside for taxes (20 = 20%).
  taxReservePct         Decimal @default(20) @db.Decimal(5, 2)
  /// Percent of gross revenue set aside for maintenance (5 = 5%).
  maintenanceReservePct Decimal @default(5) @db.Decimal(5, 2)
  /// Map of ExpenseCategory -> ExpenseBehavior overrides.
  categoryBehavior      Json    @default("{}")
  /// Owner-selected treatment of shared business overhead in Fleet unit costs.
  fleetOverheadAllocation String @default("UNALLOCATED")

  /// Profit-per-total-mile floors for the load profitability rating.
  ratingGreatPerMile    Decimal @default(2) @db.Decimal(8, 2)
  ratingGoodPerMile     Decimal @default(1.5) @db.Decimal(8, 2)
  ratingMarginalPerMile Decimal @default(1) @db.Decimal(8, 2)

  /// Deadhead share of total miles that triggers a warning.
  deadheadWarnPct      Decimal @default(20) @db.Decimal(5, 2)
  /// Remaining service life that flags maintenance as due soon.
  maintenanceWarnMiles Int     @default(2000)
  maintenanceWarnDays  Int     @default(30)
  /// Quarterly IFTA rates keyed as `YYYY-QN:ST`.
  iftaTaxRates         Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name                                String
  year                                Int?
  make                                String?
  model                               String?
  vin                                 String?
  purchasePrice                       Decimal? @db.Decimal(12, 2)
  monthlyPayment                      Decimal? @db.Decimal(12, 2)
  monthlyInsurance                    Decimal? @db.Decimal(12, 2)
  /// True only after the owner explicitly confirms this unit currently has
  /// no loan, truck payment, finance lease or other financing. Null is unknown.
  financingConfirmedNone              Boolean?
  /// Cost groups the owner explicitly confirms do not apply to this unit.
  operatingCostExemptions             Json     @default("{}")
  /// Facts used to assess whether this unit is likely subject to IFTA.
  /// Null means the owner has not answered yet; historical units are never guessed.
  axleCount                           Int?
  registeredGrossWeightLbs            Int?
  operatesInMultipleIftaJurisdictions Boolean?
  /// Owner-confirmed filing treatment. True includes this unit in quarterly
  /// IFTA reports; false excludes it; null means the decision is still pending.
  iftaReportingEnabled                Boolean?
  startingOdometer                    Int      @default(0)
  currentOdometer                     Int      @default(0)
  active                              Boolean  @default(true)

  /// When the unit joined the fleet, and when it left. A sold truck keeps all
  /// of its history and keeps appearing in past reports; it simply stops being
  /// something new work can be booked against.
  acquiredOn DateTime? @db.Date
  soldOn     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loads                 Load[]
  expenses              Expense[]
  financialObligations  FinancialObligation[]
  fuelEntries           FuelEntry[]
  documents             Document[]
  maintenance           MaintenanceRecord[]
  defaultDrivers        Driver[]               @relation("DriverDefaultTruck")
  driverSettlementLines DriverSettlementLine[]

  @@index([businessId])
}

model Load {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  /// Pickup date -- the date financial period filters key off.
  date             DateTime  @db.Date
  deliveryDate     DateTime? @db.Date
  endingOdometer   Int?
  originCity       String
  originState      String    @db.VarChar(2)
  destinationCity  String
  destinationState String    @db.VarChar(2)
  broker           String?
  loadNumber       String?

  equipmentType     EquipmentType?
  loadCapacity      LoadCapacity?
  equipmentLengthFt Int?
  weightLbs         Int?
  commodity         String?

  loadedMiles   Int
  deadheadMiles Int     @default(0)
  grossRate     Decimal @db.Decimal(12, 2)

  /// Trip-level costs, used for per-load profitability.
  fuelCost      Decimal @default(0) @db.Decimal(12, 2)
  tolls         Decimal @default(0) @db.Decimal(12, 2)
  dispatchFee   Decimal @default(0) @db.Decimal(12, 2)
  factoringFee  Decimal @default(0) @db.Decimal(12, 2)
  otherExpenses Decimal @default(0) @db.Decimal(12, 2)
  /// Frozen when a driver settlement is paid. The matching ledger expense is
  /// linked through DriverSettlementLine, so load profitability and the P&L
  /// show the same dollars without double-counting them.
  driverPay     Decimal @default(0) @db.Decimal(12, 2)
  /// True when the trip-cost fields are mirrored into the expense ledger.
  /// Defaults to FALSE so that adding this column to a database with existing
  /// loads never posts their costs retroactively -- the app sets it true
  /// explicitly for every load it creates.
  costsPosted   Boolean @default(false)

  status            PaymentStatus @default(PENDING)
  /// Actual miles split by IFTA jurisdiction. JSON keeps a trip's allocation
  /// together and avoids pretending origin/destination states describe the route.
  jurisdictionMiles Json          @default("[]")

  /// Freight invoicing is one invoice per load. Existing payment status remains
  /// the accounting state; these fields carry the customer-facing document.
  invoiceNumber   String?
  invoiceDate     DateTime? @db.Date
  invoiceDueDate  DateTime? @db.Date
  invoicePaidDate DateTime? @db.Date
  billToName      String?
  billToEmail     String?
  billToAddress   String?
  invoiceNotes    String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses             Expense[]
  fuelEntries          FuelEntry[]
  documents            Document[]
  driverSettlementLine DriverSettlementLine?
  paymentEvents        PaymentEvent[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, date])
  @@index([truckId, date])
  @@index([driverId, date])
  @@index([status])
}

model Expense {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  truckId    String?
  truck      Truck?   @relation(fields: [truckId], references: [id], onDelete: SetNull)
  loadId     String?
  load       Load?    @relation(fields: [loadId], references: [id], onDelete: SetNull)

  date               DateTime             @db.Date
  scope              ExpenseScope         @default(TRUCK)
  category           ExpenseCategory
  description        String
  vendor             String?
  amount             Decimal              @db.Decimal(12, 2)
  financialTreatment FinancialTreatment?
  obligationId       String?
  obligation         FinancialObligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  splitGroupId       String?
  recurring          Boolean              @default(false)
  receiptNumber      String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents            Document[]
  maintenance          MaintenanceRecord[]
  fuelEntry            FuelEntry?            @relation("FuelEntryExpense")
  driverSettlementLine DriverSettlementLine? @relation("DriverSettlementExpense")

  @@index([businessId, date])
  @@index([category])
  @@index([loadId])
  @@index([truckId, date])
  @@index([obligationId])
}

model FinancialObligation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  truckId    String?
  truck      Truck?   @relation(fields: [truckId], references: [id], onDelete: SetNull)

  name                   String
  kind                   FinancialObligationKind
  counterparty           String?
  startedOn              DateTime?               @db.Date
  endedOn                DateTime?               @db.Date
  startingBalance        Decimal?                @db.Decimal(12, 2)
  aprPercent             Decimal?                @db.Decimal(5, 2)
  paymentDueDay          Int?
  expectedMonthlyPayment Decimal?                @db.Decimal(12, 2)
  active                 Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([businessId, active])
  @@index([truckId])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loadId     String
  load       Load     @relation(fields: [loadId], references: [id], onDelete: Restrict)

  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  method    String?
  reference String?
  notes     String?

  createdAt DateTime @default(now())

  @@index([businessId, date])
  @@index([loadId, date])
}

/// Operational driver profile. We deliberately do not store SSNs, bank
/// details, licence scans or tax-withholding data here: this is a load-pay
/// ledger, not a payroll processor.
model Driver {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name           String
  reference      String?
  defaultTruckId String?
  defaultTruck   Truck?        @relation("DriverDefaultTruck", fields: [defaultTruckId], references: [id], onDelete: SetNull)
  payType        DriverPayType
  payRate        Decimal       @db.Decimal(12, 4)
  active         Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loads       Load[]
  settlements DriverSettlement[]

  @@index([businessId, active])
  @@index([defaultTruckId])
}

/// A driver-pay statement. Lines are frozen when the draft is created and a
/// load can appear in only one statement, which makes double payment a
/// database constraint rather than a UI promise.
model DriverSettlement {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)

  periodStart DateTime               @db.Date
  periodEnd   DateTime               @db.Date
  status      DriverSettlementStatus @default(DRAFT)
  paidOn      DateTime?              @db.Date
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       DriverSettlementLine[]
  adjustments DriverSettlementAdjustment[]

  @@index([businessId, periodStart])
  @@index([driverId, periodStart])
}

model DriverSettlementAdjustment {
  id           String           @id @default(cuid())
  settlementId String
  settlement   DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  type   DriverSettlementAdjustmentType
  amount Decimal                        @db.Decimal(12, 2)
  reason String

  createdAt DateTime @default(now())

  @@index([settlementId, createdAt])
}

model DriverSettlementLine {
  id           String           @id @default(cuid())
  settlementId String
  settlement   DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  loadId       String           @unique
  load         Load             @relation(fields: [loadId], references: [id], onDelete: Restrict)
  truckId      String
  truck        Truck            @relation(fields: [truckId], references: [id], onDelete: Restrict)

  grossRevenue Decimal       @db.Decimal(12, 2)
  loadedMiles  Int
  totalMiles   Int
  payType      DriverPayType
  payRate      Decimal       @db.Decimal(12, 4)
  payAmount    Decimal       @db.Decimal(12, 2)

  /// Created only when the statement is marked PAID. Unique makes retrying
  /// the payment action idempotent at the database boundary.
  expenseId String?  @unique
  expense   Expense? @relation("DriverSettlementExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([settlementId])
  @@index([truckId])
}

model FuelEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  loadId     String?
  load       Load?    @relation(fields: [loadId], references: [id], onDelete: SetNull)

  date           DateTime @db.Date
  gallons        Decimal  @db.Decimal(10, 3)
  pricePerGallon Decimal  @db.Decimal(10, 3)
  totalCost      Decimal  @db.Decimal(12, 2)
  /// Odometer at fill-up -- drives MPG once two readings exist.
  odometer       Int?
  location       String?
  jurisdiction   String?  @db.VarChar(2)

  /// The ledger row this fill-up mirrors into. An explicit relation, so the
  /// database enforces the link the application relies on.
  expenseId String?  @unique
  expense   Expense? @relation("FuelEntryExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, date])
  @@index([truckId, odometer])
}

/// A logged service or renewal. Next service can be measured by date,
/// by mileage, or by whichever arrives first.
model MaintenanceRecord {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)

  type  MaintenanceType
  basis MaintenanceBasis @default(BOTH)

  serviceDate DateTime @db.Date
  odometer    Int?
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  vendor      String?

  nextServiceDate     DateTime? @db.Date
  nextServiceOdometer Int?

  /// Set when the cost was also written to the expense ledger, so the money
  /// is counted exactly once.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@index([businessId, serviceDate])
  @@index([truckId, type])
}

/// A stored file. Exactly one owner column is set; the storageKey is opaque
/// and resolved by the storage adapter (local disk today, Supabase Storage
/// later) so moving buckets never touches application code.
model Document {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  loadId        String?
  load          Load?              @relation(fields: [loadId], references: [id], onDelete: Cascade)
  expenseId     String?
  expense       Expense?           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  truckId       String?
  truck         Truck?             @relation(fields: [truckId], references: [id], onDelete: Cascade)
  maintenanceId String?
  maintenance   MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  type        DocumentType @default(OTHER)
  label       String
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String       @unique

  uploadedAt DateTime @default(now())

  @@index([businessId])
  @@index([loadId])
  @@index([expenseId])
  @@index([truckId])
  @@index([maintenanceId])
}
