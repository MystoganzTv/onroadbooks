{
  "name": "onroad-books",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test \"src/lib/__tests__/*.test.ts\"",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "db:generate": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:verify": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:harden": "prisma db execute --file prisma/harden-data-api.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "smoke:postgres": "node --conditions=react-server --import tsx scripts/postgres-smoke.ts",
    "certify:database": "node --conditions=react-server --import tsx scripts/certify-production-database.ts",
    "certify:storage": "node --conditions=react-server --import tsx scripts/certify-production-storage.ts",
    "certify:invitations": "node --conditions=react-server --import tsx scripts/certify-production-invitations.ts",
    "certify:backup-restore": "node --conditions=react-server --import tsx scripts/certify-backup-restore.ts",
    "backup": "node --import tsx scripts/backup-database.ts",
    "backup:mail": "node --import tsx scripts/mail-backup.ts",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@countrystatecity/countries": "^1.0.9",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "^0.469.0",
    "next": "^16.3.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "stripe": "20.4.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
