{
  "name": "onroad-books",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:deploy-files": "node scripts/verify-deployment-manifest.mjs",
    "test": "node --conditions=react-server --import tsx --test \"src/lib/__tests__/*.test.ts\"",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "db:generate": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:verify": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:harden": "prisma db execute --file prisma/harden-data-api.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:drizzle:check": "drizzle-kit check --config drizzle.config.ts",
    "db:drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "smoke:postgres": "node --conditions=react-server --import tsx scripts/postgres-smoke.ts",
    "smoke:neon": "node --conditions=react-server --import tsx scripts/neon-smoke.ts",
    "verify:neon-schema": "node --conditions=react-server --import tsx scripts/verify-neon-schema.ts",
    "smoke:neon-schema": "node --conditions=react-server --import tsx scripts/neon-schema-smoke.ts",
    "certify:database": "node --conditions=react-server --import tsx scripts/certify-production-database.ts",
    "certify:storage": "node --conditions=react-server --import tsx scripts/certify-r2-storage.ts",
    "certify:invitations": "node --conditions=react-server --import tsx scripts/certify-authjs-invitations.ts",
    "certify:authjs-invitations": "node --conditions=react-server --import tsx scripts/certify-authjs-invitations.ts",
    "certify:backup-restore": "node --conditions=react-server --import tsx scripts/certify-backup-restore.ts",
    "backup": "node --import tsx scripts/backup-database.ts",
    "backup:mail": "node --import tsx scripts/mail-backup.ts",
    "postinstall": "prisma generate",
    "migrate:data": "node --import tsx scripts/copy-supabase-to-neon.ts",
    "smoke:data-copy": "node --import tsx scripts/smoke-data-copy.ts",
    "migrate:identities": "node --import tsx scripts/export-migration-identities.ts",
    "verify:migration-backup": "node --import tsx scripts/verify-migration-backup.ts",
    "test:database": "node --conditions=react-server --import tsx scripts/run-database-contracts.ts",
    "smoke:neon-repository": "node --conditions=react-server --import tsx scripts/neon-repository-smoke.ts",
    "test:browser:database": "node --conditions=react-server --import tsx scripts/run-database-contracts.ts --browser",
    "migrate:identity-links": "node --conditions=react-server --import tsx scripts/import-migration-identities.ts",
    "smoke:neon-auth": "node --conditions=react-server --import tsx scripts/neon-auth-smoke.ts",
    "test:browser:storage": "ONROAD_DISPOSABLE_STORAGE=1 node --conditions=react-server --import tsx scripts/run-database-contracts.ts --browser",
    "certify:r2": "node --conditions=react-server --import tsx scripts/certify-r2-storage.ts",
    "migrate:storage-audit": "node --import tsx scripts/audit-storage-migration.ts",
    "db:drizzle:verify": "node --import tsx scripts/verify-drizzle-deployment.ts",
    "migrate:services-audit": "node --import tsx scripts/audit-supabase-services.ts"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "deepmerge-ts": "8.0.2",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@countrystatecity/countries": "^1.0.9",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "lucide-react": "^0.469.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "stripe": "20.4.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
