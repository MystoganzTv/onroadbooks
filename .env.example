# ---------------------------------------------------------------------------
# OnRoad Books environment
# ---------------------------------------------------------------------------

# Which storage backend the app talks to.
#   json      -> bundled local JSON store, seeded on first boot. Zero setup.
#   postgres  -> Prisma against DATABASE_URL below.
DATA_SOURCE="json"

# Used when DATA_SOURCE=postgres. Works with any Postgres, including Supabase.
#   Supabase pooled:  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Supabase direct:  postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onroad_books?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/onroad_books?schema=public"

# Product name shown in the sidebar and page titles. Rename here.
NEXT_PUBLIC_APP_NAME="OnRoad Books"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random key is generated once into data/.auth-secret. Set it
# explicitly in any real deployment, or every restart signs everyone out.
# AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
#   local     (default) -> data/uploads on disk
#   supabase            -> Supabase Storage, needs the three values below
DOCUMENT_STORAGE="local"
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="documents"
