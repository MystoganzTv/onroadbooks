# ---------------------------------------------------------------------------
# OnRoad Books environment
# ---------------------------------------------------------------------------

# Which storage backend the app talks to.
#   json      -> bundled local JSON store, seeded on first boot. Zero setup.
#   postgres  -> Prisma against DATABASE_URL below.
#   neon      -> Drizzle against NEON_DATABASE_URL (explicit opt-in; no JSON fallback).
DATA_SOURCE="json"

# App Store Server API. Server only; never expose these to the iOS bundle or NEXT_PUBLIC_*.
APPLE_IAP_KEY_ID=""
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_PRIVATE_KEY=""
# Comma-separated dedicated App Review/TestFlight accounts; sandbox never grants real customer access.
APPLE_SANDBOX_ACCOUNT_EMAILS=""

# Optional location for the JSON ledger, local document uploads and generated
# development session key. Browser tests use this to stay out of `data/`.
# ONROAD_DATA_DIR=".e2e-data"

# Used by the optional Prisma reference backend (DATA_SOURCE=postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onroad_books?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/onroad_books?schema=public"

# Production uses DATA_SOURCE=neon with Drizzle. Use the pooled URL at
# runtime and the direct URL for migrations and backups. Development and
# previews must use their own Neon branch, never production credentials.
NEON_DATABASE_URL=""
NEON_DIRECT_URL=""

# Product name shown in the sidebar and page titles. Rename here.
NEXT_PUBLIC_APP_NAME="OnRoad Books"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Billing (server-side except for the application URL above).
# Create one recurring monthly Price for each plan in the same Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_FLEET_MONTHLY=""

# Optional Slack/Discord-compatible destination for immediate operational
# alerts. Runtime errors are always logged even when this is unset.
# Where a broken route reports itself. Email is the default because it is the
# inbox you already read: RESEND_API_KEY is a key from the same Resend account
# that already sends this app's auth mail, and OPERATIONS_ALERT_EMAIL is where
# alerts land. The webhook below is an alternative for anyone who wants a chat
# channel instead, and is only used when no alert email is configured.
RESEND_API_KEY=""
OPERATIONS_ALERT_EMAIL=""
OPERATIONS_ALERT_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random key is generated once into data/.auth-secret. Set it
# explicitly in any real deployment, or every restart signs everyone out.
# AUTH_SECRET=""

# Comma-separated operator accounts allowed into the platform-wide Admin
# console. Keep this server-only; workspace ADMIN roles never inherit it.
PLATFORM_ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
#   local     (default) -> data/uploads on disk
#   r2                  -> private Cloudflare R2 (production)
DOCUMENT_STORAGE="local"
#   r2 -> private Cloudflare R2; server credentials only, no public bucket URL.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="onroadbooks-documents"
# Required R2 lifecycle rule: delete objects with prefix _pending/ after 1 day.

# ---------------------------------------------------------------------------
# Rate confirmation scanning
# ---------------------------------------------------------------------------
# Reads the broker's rate confirmation PDF and prefills the load form. The
# document is held in memory for one request and never sent anywhere else; it
# is stored only if the owner saves the load, through the normal attachment
# path. Leave the key unset and the feature turns itself off -- the app runs
# exactly as before and the Scan button is not offered.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5, which reads scanned freight
# paperwork well at a cost that makes sense per load.
# RATE_CON_MODEL=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Shared secret for /api/cron/monthly-expenses, which posts each workspace's
# monthly fixed costs (truck note, insurance, recurring templates) on the day
# they fall due. Vercel Cron sends it as "Authorization: Bearer <secret>".
# Without it the endpoint refuses to run rather than defaulting to open --
# it writes to every customer's ledger.
CRON_SECRET=""

# Encrypted nightly database backups (`npm run backup`). The passphrase is the
# only thing standing between a stolen backup file and every customer's books,
# and losing it makes every existing backup unreadable -- store it somewhere
# that is not this machine. BACKUP_DIR must sit outside the repository.
BACKUP_PASSPHRASE=
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
# Where the nightly cloud backup is mailed. The repository is public, so the
# encrypted dump is never kept as a workflow artifact -- it goes to an inbox
# through RESEND_API_KEY above. Falls back to OPERATIONS_ALERT_EMAIL when unset.
BACKUP_EMAIL=

# Production: AUTH_PROVIDER=authjs with DATA_SOURCE=neon. The legacy setting
# supports local password-only development; Google and invitations use Auth.js.
AUTH_PROVIDER="legacy"
# AUTH_URL="https://onroadbooks.com"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET="" # Server only; existing Google OAuth client secret.
# AUTH_EMAIL_FROM="OnRoad Books <no-reply@onroadbooks.com>"
# Optional fixed deadline for accepting old signed WEB cookies during cutover.
# Mobile bearer compatibility is retained independently.
# AUTH_LEGACY_SESSION_UNTIL="2026-09-27T19:00:00.000Z"

# ---------------------------------------------------------------------------
# OnRoad AI -- WhatsApp freight assistant (docs/onroad-ai.md, ADR 0033)
# ---------------------------------------------------------------------------
# Master switch. Anything but "true" and every /api/whatsapp route answers 404.
ONROAD_AI_ENABLED="false"
# Meta WhatsApp Business Platform (Cloud API). From the Meta app dashboard:
#   WhatsApp > API Setup     -> phone number ID, permanent System User token
#   App settings > Basic     -> app secret (signs every webhook POST)
# The verify token is any random string of 16+ characters you also paste
# into the webhook configuration in Meta. All server only.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_GRAPH_VERSION="v24.0"
# Message interpretation (screenshots, PDFs, free text) uses ANTHROPIC_API_KEY
# above. Without it the bot still prices loads typed in shorthand.
# ONROAD_AI_MODEL=""
# Voice notes need speech-to-text. Unset = the bot asks drivers to type.
OPENAI_API_KEY=""
# ONROAD_AI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
# Operations API (/api/whatsapp/admin). 32+ characters; unset = route is off.
ONROAD_AI_ADMIN_TOKEN=""
# Local development only: keep the assistant's data in memory instead of Neon.
# ONROAD_AI_STORE="memory"
# In-app chat bubble with the same bot, for platform admins only (testing window).
# ONROAD_AI_WEBCHAT="true"
# Development only: a clearly labelled TEST DATA load board. Ignored in production.
# ONROAD_AI_MOCK_LOADBOARD="1"
# Per-driver limits and cost estimates (defaults shown).
# ONROAD_AI_BURST_PER_MINUTE=8
# ONROAD_AI_MESSAGES_PER_DAY=200
# ONROAD_AI_AI_CALLS_PER_DAY=60
# ONROAD_AI_TRANSCRIPTIONS_PER_DAY=30
# ONROAD_AI_WHATSAPP_COST_PER_MESSAGE=0.0034
# ONROAD_AI_INPUT_USD_PER_MTOK=3
# ONROAD_AI_OUTPUT_USD_PER_MTOK=15
# ONROAD_AI_TRANSCRIBE_USD_PER_MINUTE=0.003
# ONROAD_AI_RETENTION_DAYS=30
# ONROAD_AI_TIME_ZONE="America/New_York"
# Load alerts (only ever run against an AUTHORIZED load board -- a no-op
# until one is connected). Outside the 24-hour window an alert can only be
# delivered through an APPROVED utility template; leave unset and alerts wait
# until the driver writes again. The template takes two body parameters:
# {{1}} number of loads, {{2}} the alert's description.
# WHATSAPP_ALERT_TEMPLATE=""
# WHATSAPP_ALERT_TEMPLATE_LANG_EN="en_US"
# WHATSAPP_ALERT_TEMPLATE_LANG_ES="es"
# ONROAD_AI_ALERT_INTERVAL_MINUTES=60
# ONROAD_AI_ALERT_LOADS_PER_MESSAGE=3
# ONROAD_AI_ALERT_LOADS_PER_DAY=5
# ONROAD_AI_ALERTS_PER_RUN=50
# Plans and billing (Phase 4). Billing stays OFF -- everyone on the limits
# above -- until BOTH a Stripe price for OnRoad AI and its webhook secret are
# set. Create a recurring monthly price in the same Stripe account; the
# amount is your decision. Add a SEPARATE webhook endpoint in Stripe:
#   https://onroadbooks.com/api/whatsapp/stripe
#   events: checkout.session.completed, customer.subscription.created,
#           customer.subscription.updated, customer.subscription.deleted
# STRIPE_PRICE_ONROAD_AI_MONTHLY=""
# STRIPE_ONROAD_AI_WEBHOOK_SECRET=""
# ONROAD_AI_CHECKOUT_RETURN_URL=""          # where Stripe sends the driver back (default: the app URL)
# Per-plan daily limits (defaults shown). "Reads" are AI reads of screenshots,
# PDFs and free text; typed shorthand loads never use one.
# ONROAD_AI_FREE_MESSAGES_PER_DAY=40
# ONROAD_AI_FREE_AI_CALLS_PER_DAY=5
# ONROAD_AI_FREE_TRANSCRIPTIONS_PER_DAY=3
# ONROAD_AI_FREE_MAX_ALERTS=1
# ONROAD_AI_PRO_MESSAGES_PER_DAY=400
# ONROAD_AI_PRO_AI_CALLS_PER_DAY=120
# ONROAD_AI_PRO_TRANSCRIPTIONS_PER_DAY=60
# ONROAD_AI_PRO_MAX_ALERTS=5
# Abuse and cost controls.
# ONROAD_AI_ALLOWED_COUNTRY_CODES="1"       # only these calling codes can start (US/Canada); empty = all
# ONROAD_AI_NEW_USERS_PER_HOUR=30           # first contacts beyond this are ignored
# ONROAD_AI_NEW_USER_SPIKE=100              # alert when this many new numbers appear in 24 h
# Monitoring and cost reporting (/admin/onroad-ai and the daily alert email).
# ONROAD_AI_DAILY_BUDGET_USD=0              # alert when today's estimated cost passes it; 0 = off
# ONROAD_AI_FIXED_MONTHLY_COST_USD=0        # your share of Vercel/Neon, for the margin line
# DAT load board -- leave OFF until DAT has approved API access AND confirmed
# in writing that results and broker details may be shown to our users.
# The adapter has no endpoints until they are written from DAT's own docs.
DAT_API_ENABLED="false"
DAT_CLIENT_ID=""
DAT_CLIENT_SECRET=""
DAT_COMMERCIAL_USE_CONFIRMED="false"
